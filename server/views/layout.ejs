<%
  // Fragment renders (the live-refresh routes) reuse the same partials as the full pages, so they
  // come through this layout too. @fastify/view's `layout` option can only *set* a layout, never
  // switch it off per render — so the opt-out lives here: `fragment: true` yields the body alone.
  const bare = typeof fragment !== 'undefined' && fragment;
%>
<% if (bare) { %><%- body %><% } else { %>
<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> · Digital Aid</title>

  <link rel="manifest" href="/public/manifest.webmanifest">
  <meta name="theme-color" id="theme-color" content="#f9f9ff">
  <script>
    (() => {
      let saved = null;
      try { saved = localStorage.getItem('digital-aid-theme'); } catch {}
      const theme = saved === 'light' || saved === 'dark'
        ? saved
        : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
      document.getElementById('theme-color').content = theme === 'dark' ? '#10121c' : '#eef0f7';
    })();
  </script>
  <link rel="icon" href="/public/icons/favicon-32.png" sizes="32x32">
  <link rel="icon" href="/public/icons/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Digital Aid">
  <meta name="mobile-web-app-capable" content="yes">

  <link rel="stylesheet" href="<%= asset('/public/vendor/beer.min.css') %>">
  <link rel="stylesheet" href="<%= asset('/public/style.css') %>">
</head>
<body>
<%
  // Four destinations. Update and Password are opened a handful of times a year and do not deserve
  // a tab; Settings absorbs them. "Codes" is deliberately named after neither code it holds: it used
  // to be named after the Admin Code, which is the one nobody should be reaching for daily. Requests earns one because it is the only screen someone else can
  // put work on — its badge is a live fragment so every page carries it without a per-view count.
  const nav = typeof navActive === 'undefined' ? '' : navActive;
  const chrome = typeof showNav === 'undefined' ? true : showNav;
%>
<% if (chrome) { %>
  <header class="appbar">
    <a class="brand" href="/clients"><img src="/public/icons/icon.svg" alt="" width="24" height="24">Digital Aid</a>
    <button type="button" class="theme-toggle" id="theme-toggle"
            data-light-label="<%= t('theme.switchLight') %>" data-dark-label="<%= t('theme.switchDark') %>">
      <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg>
    </button>
  </header>
<% } %>

  <main class="shell">
    <%- body %>
  </main>

<% if (chrome) { %>
  <%# One nav, both shapes: a bottom bar under the thumb on a phone, a rail on a desktop.
      style.css decides which by viewport — the markup never changes. %>
  <nav class="tabbar">
    <a href="/clients" class="<%= nav === 'clients' ? 'on' : '' %>" aria-current="<%= nav === 'clients' ? 'page' : 'false' %>">
      <span class="pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>
      </svg></span>
      <%= t('nav.clients') %>
    </a>
    <a href="/requests" class="<%= nav === 'requests' ? 'on' : '' %>" aria-current="<%= nav === 'requests' ? 'page' : 'false' %>">
      <span class="pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/><path d="M12 7v4M12 13.5v.01"/>
      </svg><span class="ask-badge" data-live-src="/requests/badge" data-live-every="15000" aria-live="polite"></span></span>
      <%= t('nav.requests') %>
    </a>
    <a href="/family-code" class="<%= nav === 'family-code' ? 'on' : '' %>" aria-current="<%= nav === 'family-code' ? 'page' : 'false' %>">
      <span class="pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <circle cx="9" cy="12" r="4"/><path d="M13 12h8M18 12v3M21 12v2"/>
      </svg></span>
      <%= t('nav.codes') %>
    </a>
    <a href="/settings" class="<%= nav === 'settings' ? 'on' : '' %>" aria-current="<%= nav === 'settings' ? 'page' : 'false' %>">
      <span class="pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <circle cx="12" cy="12" r="3"/>
        <path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>
      </svg></span>
      <%= t('nav.settings') %>
    </a>
  </nav>
<% } %>

  <script type="module" src="<%= asset('/public/theme.js') %>"></script>
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
    }
  </script>
</body>
</html>
<% } %>
